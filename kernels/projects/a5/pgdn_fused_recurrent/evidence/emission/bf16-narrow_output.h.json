    {"line": 1, "text": "#pragma once"},
    {"line": 2, "text": "#include \"tensorutils_cce.h\""},
    {"line": 3, "text": "using namespace ascrip;"},
    {"line": 4, "text": ""},
    {"line": 5, "text": "__aicore__ inline void narrow_output(__ubuf__ float* source, __ubuf__ bfloat16_t* out, int32_t steps)"},
    {"line": 6, "text": "{"},
    {"line": 7, "text": "    __VEC_SCOPE__"},
    {"line": 8, "text": "    {"},
    {"line": 9, "text": "        vector_f32 value;  // #365"},
