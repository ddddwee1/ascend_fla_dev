    {"line": 16, "text": "    const int32_t HAS_A = tiling_data.HAS_A;"},
    {"line": 17, "text": "    if ASCEND_IS_AIV {"},
    {"line": 18, "text": "        pgdn_recurrent_bf16_vec(q, k, v, g_atk, g, beta_atk, beta, initial_state, initial_A_state, o, final_state, final_A_state, B, S, H, HV, HAS_INITIAL, HAS_A, workspace);"},
    {"line": 19, "text": "    }"},
    {"line": 20, "text": "}"}
