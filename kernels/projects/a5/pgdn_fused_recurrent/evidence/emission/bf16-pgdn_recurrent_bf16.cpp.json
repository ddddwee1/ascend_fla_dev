    {"line": 8, "text": "    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);"},
    {"line": 9, "text": "    GET_TILING_DATA(tiling_data, tiling);"},
    {"line": 10, "text": "    pipe_barrier(PIPE_ALL);"},
    {"line": 11, "text": "    const int32_t B = tiling_data.B;"},
    {"line": 12, "text": "    const int32_t S = tiling_data.S;"},
