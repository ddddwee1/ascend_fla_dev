    {"line": 6, "text": "extern \"C\" __global__ __aicore__ void pgdn_recurrent_bf16(GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR g_atk, GM_ADDR g, GM_ADDR beta_atk, GM_ADDR beta, GM_ADDR initial_state, GM_ADDR initial_A_state, GM_ADDR o, GM_ADDR final_state, GM_ADDR final_A_state, GM_ADDR workspace, GM_ADDR tiling)"},
