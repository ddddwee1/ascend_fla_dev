{
  "schema": "ascriptor.kernel-unit/1",
  "id": "a5.pgdn_fused_recurrent",
  "kind": "kernel",
  "description": "Short-step PGDN with head-local ATK and independent grouped main state, native BF16/FP32.",
  "inputs": {
    "q": {
      "dtype": "float32",
      "shape": [
        "B",
        "S",
        "H",
        128
      ]
    },
    "k": {
