      "shape": [
        "B",
        "S",
        "H",
        128
      ]
    },
    "v": {
      "dtype": "float32",
      "shape": [
        "B",
        "S",
        "HV",
        128
      ]
    },
    "g_atk": {
      "dtype": "float32",
      "shape": [
        "B",
        "S",
        "H"
      ]
    },
    "g": {
      "dtype": "float32",
      "shape": [
        "B",
        "S",
        "HV"
      ]
    },
    "beta_atk": {
      "dtype": "float32",
      "shape": [
        "B",
        "S",
        "H"
      ]
    },
    "beta": {
      "dtype": "float32",
      "shape": [
        "B",
        "S",
        "HV"
      ]
    },
    "initial_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "HV",
        128,
        128
      ]
    },
    "initial_A_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128
      ]
    }
  },
  "outputs": {
    "o": {
      "dtype": "float32",
      "shape": [
        "B",
        "S",
        "HV",
        128
      ]
    },
    "final_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "HV",
        128,
        128
      ]
    },
    "final_A_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128
      ]
    }
  },
  "domain": {
    "S": "1..16",
    "K": 128,
    "V": 128,
    "grouping": "HV positive multiple of H; contiguous value-head groups",
    "state": "independent None/nonzero main and ATK states, both fresh outputs",
    "normalization": "FP32 x/max(norm(x),1e-12), q then scales128**-.5",
    "numeric": "finite, nonnegative A, g/g_atk<=0, beta/beta_atk in[0,1], no FP32 intermediate overflow",
    "block_dim": [
      1,
      2,
      4,
      8,
      16,
      28
    ],
    "qualification": "Native inprocess: 126 FP32/BF16 cases at each listed block_dim, with byte-identical outputs; measured magnitudes and oracle identity are in evidence. No arbitrary-finite-input accuracy claim.",
    "constants": {
      "x": 1.5,
      "eps": 1e-06,
      "log_atk_scale": -0.2
    }
  },
  "dependencies": {
    "python": ">=3.10",
    "ascriptor": "==0.1.0",
    "host": [
      "torch>=2.9",
      "numpy",
      "einops"
    ]
  },
  "comparison": {
    "default": {
      "mode": "allclose",
      "atol": 2e-05,
      "rtol": 0.0002,
      "max_relative_l2": 0.0001,
      "reason": "Fixed FP32 relative-L2<=1e-4 against literal A and independent B; additional elementwise guard frozen before device execution."
    }
  },
